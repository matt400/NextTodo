generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  engineType             = "client"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  lastLogin DateTime @default(now())
}

model Tasks {
  id         Int      @id @default(autoincrement())
  taskName   String
  created    DateTime
  isFinished Boolean
  userId     Int
}

model Pomo {
  id       Int     @id @default(autoincrement())
  timeLeft Int
  isActive Boolean
  taskId   Int
}
